<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Ad Hoc: the only certificate on this Mac is an Apple Distribution one,
         so the build is exported ad-hoc (installs on the registered devices,
         no App Store involved). A Development certificate would be needed for
         method=development. -->
    <key>method</key>
    <string>ad-hoc</string>
    <key>teamID</key>
    <string>G6XG9572FX</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>stripSwiftSymbols</key>
    <true/>
    <key>compileBitcode</key>
    <false/>
    <key>uploadSymbols</key>
    <false/>
    <key>destination</key>
    <string>export</string>
</dict>
</plist>
